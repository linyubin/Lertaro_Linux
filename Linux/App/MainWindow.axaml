<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Lertaro.Linux.Core"
        x:Class="Lertaro.Linux.App.MainWindow"
        Title="Lertaro"
        Width="760"
        Height="520"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
        <TextBox x:Name="QueryBox"
                 FontSize="20"
                 PlaceholderText="Search files and folders; use > for applications"
                 TextChanged="OnQueryChanged"
                 KeyDown="OnQueryKeyDown" />

        <ListBox x:Name="ResultsList"
                 Grid.Row="1"
                 KeyDown="OnResultsKeyDown"
                 DoubleTapped="OnResultsDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:LinuxDesktopResult">
                    <Grid RowDefinitions="Auto,Auto" Margin="4,6">
                        <TextBlock Text="{Binding Name}" FontSize="15" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Subtitle}"
                                   FontSize="12"
                                   Opacity="0.65"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Opacity="0.7"
                   Text="Type to search files, or prefix with > to launch applications." />
    </Grid>
</Window>
